{
  "nodeModulesDir": "manual",
  "unstable": ["kv"],
  "tasks": {
    "dev": "vite",
    "build": "vite build",
    "start": "deno serve -A --unstable-kv _fresh/server.js",
    "seed": "deno run -A --unstable-kv scripts/seed.ts",
    "generate": "deno run -A --unstable-kv scripts/generate.ts",
    "demo": "deno run -A --unstable-kv scripts/demo.ts",
    "test": "deno test -A --unstable-kv tests/",
    "check": "deno fmt --check . && deno lint . && deno check frontend backend shared scripts tests",
    "fix": "deno fmt . && deno lint --fix ."
  },
  "lint": {
    "rules": { "tags": ["fresh", "recommended"] },
    "exclude": ["_fresh/", "docs/"]
  },
  "fmt": {
    "exclude": [
      "_fresh/",
      "deno.lock",
      "**/*.md",
      "docs/js/",
      "docs/css/efektai.css",
      "docs/data/"
    ]
  },
  "exclude": ["**/_fresh/*"],
  "imports": {
    "@/": "./",
    "@backend/": "./backend/",
    "@shared/": "./shared/",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "preact": "npm:preact@^10.29.1",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "vite": "npm:vite@^7.1.3",
    "@types/babel__core": "npm:@types/babel__core@^7.20.5",
    "tailwindcss": "npm:tailwindcss@^4.1.10",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.12",
    "@anthropic-ai/sdk": "npm:@anthropic-ai/sdk@^0.126.0",
    "zod": "npm:zod@^4.6.5",
    "@std/assert": "jsr:@std/assert@^1.0.14",
    "@std/ulid": "jsr:@std/ulid@^1.0.0"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns",
      "deno.unstable"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": ["vite/client"]
  }
}
